# 复制为 .env 后填写；.env 已被 .gitignore 排除
# 从 @BotFather 获取，形如 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# 可选：只允许这些 Telegram 用户 ID 使用（逗号或空格分隔）。留空 = 所有人可用。
# 自己的 ID 可以问 @userinfobot。
ALLOWED_USER_IDS=

# 可选：UDD 只读镜像。不配置则 /pkg 命令自动禁用。
UDD_DSN=postgresql://udd-mirror:udd-mirror@udd-mirror.debian.net:5432/udd

# 可选：访问 api.telegram.org 需要代理时填写（http:// 或 socks5://）
TELEGRAM_PROXY=

# 可选：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
